# Mẫu tệp .env. KHÔNG tự viết mật khẩu vào đây: chạy  bash tools/init-env.sh  để sinh .env với mật khẩu ngẫu nhiên.
#
# Bản MỘT MÁY (docker-compose.yml ở gốc): chỉ cần chạy tools/init-env.sh, không phải sửa gì thêm.
# Bản 3 MÁY ẢO (soc/ và web/): chạy tools/init-env.sh trên máy SOC, thêm các biến "riêng từng máy" bên dưới
#   vào .env, rồi chép NGUYÊN tệp .env sang máy WEB (hai máy phải dùng chung mật khẩu Kafka).

# ---- bí mật: do tools/init-env.sh sinh (để trống ở đây) ----
ES_PASSWORD=                 # tài khoản quản trị elastic (chỉ es-init và healthcheck dùng)
ES_WRITER_PASSWORD=          # nsm_writer: classifier, tier3, responder, logsink — chỉ thêm bản ghi
ES_RULEGEN_PASSWORD=         # nsm_rulegen: đọc sự kiện, ghi rule-status, xoá chỉ mục quá hạn
ES_CTL_PASSWORD=             # nsm_ctl: công cụ nsmctl — chỉ đọc nhật ký kiểm toán
GRAFANA_ES_PASSWORD=         # tài khoản chỉ đọc grafana_ro (datasource của Grafana)
GRAFANA_ADMIN_PASSWORD=      # đăng nhập Grafana (tài khoản admin)
DVWA_DB_PASS=                # mật khẩu CSDL của DVWA
# Chế độ LAB — chỉ có khi chạy  bash tools/init-env.sh --lab  (mặc định KHÔNG có hai dòng này = chế độ an toàn)
# DVWA_DISABLE_AUTH=true     # DVWA không cần đăng nhập (chỉ trong lab cô lập)
# DVWA_SECURITY_LEVEL=low    # mức bảo mật thấp để tấn công chạm tới mã dễ tổn thương thật

# ---- tuỳ chọn (không phải bí mật) ----
# ALERT_WEBHOOK_URL=https://...   # nhận cảnh báo Grafana qua webhook (Slack/Teams/Telegram bot...); trống = chỉ trong Grafana
# TIER2_MODE=observe              # observe (mặc định) | corroborate | enforce — xem README
# SHARED_CIDRS=                   # IP dùng chung đã biết (NAT/proxy): chặn theo (IP, User-Agent) thay vì cả IP
KAFKA_ADMIN_PASSWORD=        # quản trị Kafka (tạo topic, cấp ACL)
KAFKA_CLASSIFIER_PASSWORD=
KAFKA_TIER3_PASSWORD=
KAFKA_RESPONDER_PASSWORD=    # tài khoản duy nhất ghi được enforce.blocklist
KAFKA_RULEGEN_PASSWORD=      # tài khoản duy nhất ghi được enforce.rules
KAFKA_LOGSINK_PASSWORD=
KAFKA_CTL_PASSWORD=          # công cụ quản trị (nsmctl): tài khoản duy nhất ghi được nsm.control
KAFKA_FILEBEAT_PASSWORD=     # dùng trên máy WEB: chỉ ghi được các topic nhật ký
KAFKA_ENFORCER_PASSWORD=     # dùng trên máy WEB: chỉ đọc enforce.*, ghi enforce.status

# ---- riêng bản 3 máy ảo: máy SOC ----
SOC_IP=10.10.30.20                 # IP card int của máy SOC; Kafka mở 9092 trên IP này cho máy WEB

# ---- riêng bản 3 máy ảo: máy WEB ----
KAFKA_BOOTSTRAP=10.10.30.20:9092   # = SOC_IP:9092
SURICATA_IFACE=ens38               # tên card ext (đối diện Kali) — xem bằng `ip -br addr`
HOME_NET=[10.10.10.10/32]          # địa chỉ máy chủ web trên card ext
